{
  "name": "thefaceanalysis-embed",
  "version": "0.3.1",
  "description": "Add free face measurement widgets to any website: 11 tools (face shape, eye shape, canthal tilt, nose and lip proportions, thirds, fWHR, midface ratio, symmetry, golden ratio, pupillary distance) as a <face-analysis-widget> web component and a React component, in 14 languages. The measurement runs in the visitor's browser.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "./src/index.js"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "homepage": "https://thefaceanalysis.com/embed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Face-Analysis/thefaceanalysis-embed.git"
  },
  "keywords": [
    "face-shape",
    "eye-shape",
    "fwhr",
    "canthal-tilt",
    "pupillary-distance",
    "golden-ratio",
    "widget",
    "web-component",
    "react",
    "embed",
    "face-analysis",
    "iframe"
  ],
  "license": "MIT"
}
